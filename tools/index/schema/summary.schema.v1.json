{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "erdem.summary.v1",
  "title": "Erdem summary, schema version 1",
  "type": "object",
  "required": ["schema", "schemaVersion", "tool", "generatedAt", "source", "path", "scope", "fingerprint", "purpose", "architecturalRole", "dependencies", "consumers", "constraints", "risks", "volatileFields", "notice"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "erdem.summary" },
    "schemaVersion": { "const": 1 },
    "tool": { "type": "object", "required": ["name", "version"] },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "source": { "type": "string" },
    "path": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["file", "directory", "subsystem", "project"] },
    "fingerprint": {
      "type": "object",
      "required": ["algo", "hash"],
      "properties": {
        "algo": { "type": "string" },
        "hash": { "type": ["string", "null"] },
        "count": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 },
        "normalization": { "type": ["string", "null"] },
        "reason": { "type": "string" }
      }
    },
    "purpose": { "type": ["string", "null"] },
    "architecturalRole": { "type": "string" },
    "dependencies": { "type": "object", "required": ["local", "localCount", "external", "externalCount"] },
    "consumers": { "type": "object", "required": ["ids", "count"] },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "object", "required": ["level", "basis"] },
    "volatileFields": { "type": "array", "items": { "type": "string" } },
    "notice": { "type": "string" }
  }
}
